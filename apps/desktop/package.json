{
  "name": "@harness/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "agentic.sidekick — native macOS app for the agentic.sidekick web UI (Tauri).",
  "scripts": {
    "build:runtime": "node ../../scripts/prepare-dsh-runtime.mjs",
    "build:server": "bun build --compile --target=bun-darwin-arm64 ../web/src/server.ts --outfile src-tauri/binaries/harness-server-aarch64-apple-darwin",
    "icons": "tauri icon src-tauri/icons/app-icon.png",
    "dev": "bun run build:server && tauri dev",
    "build": "tauri build && node ../../scripts/sign-desktop.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
