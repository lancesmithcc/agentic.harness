{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentic.harness",
  "version": "0.1.0",
  "identifier": "cc.lancesmith.agentic",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "bun run build:runtime && bun run build:server"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "One agent environment, many minds.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/harness-server"],
    "resources": {
      "../../web/index.html": "web/index.html",
      "../../web/brand.css": "web/brand.css",
      "../../web/models-meta.json": "web/models-meta.json",
      "../../web/verbs.json": "web/verbs.json",
      "../../web/assets/": "web/assets/",
      "../.runtime/": "dsh-runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    }
  }
}
